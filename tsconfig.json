{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "site/js/core/**/*.js",
    "site/js/mappers/**/*.js",
    "site/js/chat/**/*.js",
    "site/js/api/**/*.js",
    "mcp/src/**/*.js"
  ],
  "exclude": ["site/js/**/*.test.js"]
}
