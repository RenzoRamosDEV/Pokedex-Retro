{
  "name": "pokedex-retro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"site/js/**/*.test.js\" \"scripts/**/*.test.mjs\"",
    "test:mutation": "timeout 180 stryker run",
    "test:mutation:ui": "npm run test:mutation:ui:render && timeout 180 stryker run stryker.ui.config.json",
    "test:mutation:ui:render": "timeout 180 stryker run stryker.ui-render.config.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "check:html": "node scripts/check-html.mjs",
    "e2e": "playwright test",
    "version": "node scripts/sync-version.mjs && git add site/js/version.js",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.1.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix --no-warn-ignored",
      "prettier --write --ignore-unknown"
    ],
    "*.{json,md,html,css,yml,yaml}": "prettier --write --ignore-unknown"
  }
}
