{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test --experimental-test-isolation=none \"site/js/chat/*.test.js\" \"site/js/chat/proveedores/anthropic.test.js\" \"site/js/chat/proveedores/index.test.js\""
  },
  "mutate": [
    "site/js/chat/**/*.js",
    "!site/js/chat/**/*.test.js",
    "!site/js/chat/herramientas.js",
    "!site/js/chat/proveedores/openai.js"
  ],
  "ignorePatterns": ["tsconfig.json"],
  "thresholds": {
    "high": 95,
    "low": 90,
    "break": 95
  },
  "reporters": ["clear-text", "progress"],
  "timeoutMS": 10000
}
