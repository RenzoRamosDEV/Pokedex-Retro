{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test --experimental-test-isolation=none \"site/js/core/**/*.test.js\" \"site/js/mappers/**/*.test.js\""
  },
  "mutate": [
    "site/js/core/**/*.js",
    "site/js/mappers/**/*.js",
    "!site/js/**/*.test.js",
    "!site/js/core/mensajes.js",
    "!site/js/core/type-chart.js",
    "!site/js/core/consultas.js",
    "!site/js/core/guias.js"
  ],
  "ignorePatterns": ["tsconfig.json"],
  "thresholds": {
    "high": 95,
    "low": 90,
    "break": 95
  },
  "reporters": ["clear-text", "progress"],
  "timeoutMS": 10000
}
