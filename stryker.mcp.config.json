{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test --experimental-test-isolation=none \"mcp/test/*.test.js\""
  },
  "mutate": ["mcp/src/tools/**/*.js", "mcp/src/resources/**/*.js", "mcp/src/prompts/**/*.js"],
  "ignorePatterns": ["tsconfig.json"],
  "thresholds": {
    "high": 90,
    "low": 85,
    "break": 85
  },
  "reporters": ["clear-text", "progress"],
  "timeoutMS": 10000
}
