{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.renzoramosdev/pokedex-retro",
  "title": "Pokédex Retro",
  "description": "Consulta Pokémon, movimientos, habilidades, objetos, bayas, tipos y naturalezas de PokéAPI",
  "version": "1.4.0",
  "repository": {
    "url": "https://github.com/RenzoRamosDEV/Pokedex-Retro",
    "source": "github",
    "subfolder": "mcp"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "pokedex-retro-mcp",
      "version": "1.4.0",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        {
          "name": "POKEDEX_MCP_LOG",
          "description": "Nivel de registro en stderr",
          "isRequired": false,
          "default": "error",
          "choices": ["error", "info", "debug"]
        },
        {
          "name": "POKEDEX_MCP_DISK_CACHE",
          "description": "Con 1 guarda las respuestas de PokéAPI en disco 24 h",
          "isRequired": false,
          "choices": ["1"]
        }
      ]
    }
  ]
}
